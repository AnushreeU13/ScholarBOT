# Build from production_app/backend as context:
#   docker build -f production_app/docker/Dockerfile.backend -t scholarbot-backend production_app/backend
FROM python:3.11-slim

WORKDIR /app

# torch/transformers need build tools for a couple of transitive deps on slim images.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app ./app
COPY scripts ./scripts

ENV CHROMA_PERSIST_DIR=/data/chroma
VOLUME ["/data/chroma"]

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
